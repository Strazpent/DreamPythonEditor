		},
		{
			"Name": "DreamEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [ "Win64", "Linux", "Mac" ]
		},
		{
			"Name": "DreamEditorTests",
			"Comment": "Repository only (TDD 2.2): release builds use a descriptor without this module; T-ARCH-004 fails a package that contains it.",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [ "Win64", "Linux", "Mac" ]
		}
	],
	"Plugins": [
		{ "Name": "PythonScriptPlugin", "Enabled": true }
	]
}
